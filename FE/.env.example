# =========================================================================
# ProjectK9 Frontend Configuration Template (.env.example)
# Rename this file to '.env' and fill in your actual credentials.
# =========================================================================

# Google OAuth 2.0 Credentials (for client-side Google Sign-In button)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret_here
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173

# Backend API Endpoints
# Use http://localhost:5000 in local development.
VITE_API_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000
VITE_ENABLE_SPEAKING_PRACTICE=false
