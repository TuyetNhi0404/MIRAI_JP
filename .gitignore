# ==========================================
# Root .gitignore for ProjectK9
# ==========================================

# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Local configuration and environment secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env

# Build and distribution directories
dist/
build/
out/
.next/
.nuxt/
.expo/
bin/
obj/

# TypeScript build artifacts that tsc emits (must never live in src/)
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
src/**/*.d.ts.map

# Logs and databases
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.db
*.sqlite

# IDEs and Editor directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.classpath
.project
.settings/
.DS_Store
Thumbs.db

listening_knowledge.html
summary.html
ke-hoach-tich-hop-api-listening.txt
BE/design_system_output.md
BE/plan.md
FE/agent

/agents
/rules
/docs
log.txt
/ui-ux-pro-max-skill

# Local tooling (uv + portable Python)
.mirai/

# Python speaking service
services/speaking-practice/venv/
services/speaking-practice/.venv/
services/speaking-practice/uploads/*
!services/speaking-practice/uploads/.gitkeep
services/speaking-practice/.hf_cache/
services/melo-tts/venv/
services/melo-tts/.venv/
services/melo-tts/.melo-installed

# Local AI model files (GGUF, whisper.cpp models, etc.)


# whisper.cpp build artefacts (if cloned inside project)
whisper.cpp/
**/whisper.cpp/

# Model files (very large binary blobs)
*.gguf

deploy.sh
gsap-skills/
taste-skill/
req.txt

fugashi-1.5.2-cp312-cp312-manylinux2014_x86_64.manylinux_2_17_x86_64.whl