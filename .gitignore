# ==========================================
# Root .gitignore for ProjectK9
# ==========================================

# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Local configuration and environment secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env

# Build and distribution directories
dist/
build/
out/
.next/
.nuxt/
.expo/
bin/
obj/

# Logs and databases
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.db
*.sqlite

# IDEs and Editor directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.classpath
.project
.settings/
.DS_Store
Thumbs.db
