# Copy to .env in this folder and fill secrets.
#
# NOTE: For local dev via `npm run dev:speaking`, most vars
# are auto-set by scripts/run-speaking.mjs — you only need:
#   GEMINI_API_KEY   (fallback when local LLM fails)
#   OPENROUTER_API_KEY (final fallback)

GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local AI stack. Khi chạy `npm run dev:speaking`, script tự chọn đúng đường
# dẫn Whisper/Melo/llama.cpp của Windows hoặc Linux; không cần WHISPER_BIN/
# WHISPER_MODEL và không dùng đường dẫn Docker (/usr/local/bin, /models).
# Đặt model GGUF tại models/mirai-jp.gguf, hoặc khai báo path tương đối/tuyệt đối:
LOCAL_LLM_MODEL_PATH=models/mirai-jp.gguf
LOCAL_LLM_URL=http://localhost:8080
LOCAL_LLM_MODEL=mirai-jp
MELO_TTS_URL=http://localhost:8001
# 0 = CPU. Chỉ dùng giá trị lớn hơn khi tự build llama.cpp có backend GPU.
LLAMA_GPU_LAYERS=0
WHISPER_MODEL_SIZE=medium
LLM_MAX_TOKENS=512

# Auth
SPEAKING_INTERNAL_KEY=mirai-speaking-dev-key
SKIP_SPEAKING_AUTH=false
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173
