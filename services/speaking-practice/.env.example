# Copy to .env in this folder and fill secrets.
#
# NOTE: For local dev via `npm run dev:speaking`, most vars
# are auto-set by scripts/run-speaking.mjs — you only need:
#   GEMINI_API_KEY   (fallback when local LLM fails)
#   OPENROUTER_API_KEY (final fallback)

GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local AI stack — auto-set by run-speaking.mjs, override if needed
WHISPER_BIN=/usr/local/bin/whisper-cli
WHISPER_MODEL=/models/ggml-small.bin
LOCAL_LLM_URL=http://localhost:8080
LOCAL_LLM_MODEL=qwen3-1.7b-q4_k_m
MELO_TTS_URL=http://localhost:8001
LLM_MAX_TOKENS=512

# Auth
SPEAKING_INTERNAL_KEY=mirai-speaking-dev-key
SKIP_SPEAKING_AUTH=false
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173
