# Copy to .env in this folder and fill secrets.
#
# NOTE: For local dev via `npm run dev:speaking`, most vars
# are auto-set by scripts/run-speaking.mjs — you only need:
#   GEMINI_API_KEY
#   OPENROUTER_API_KEY
#
# LLM chain: Gemini → OpenRouter → (optional) Local as FINAL chốt chặn.
# `npm run dev:speaking` sẽ hỏi Y/N lúc start:
#   Y = bật local làm chốt cuối (cần GGUF)
#   N = chỉ Gemini → OpenRouter, dừng
# Hoặc set sẵn: USE_LOCAL_LLM=true|false và SKIP_LOCAL_LLM_PROMPT=1

GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local AI stack. Khi chạy `npm run dev:speaking`, script tự chọn đúng đường
# dẫn Whisper/llama.cpp; không cần WHISPER_BIN/WHISPER_MODEL Docker paths.
# Đặt model GGUF tại models/mirai-jp.gguf, hoặc khai báo path tương đối/tuyệt đối:
LOCAL_LLM_MODEL_PATH=models/mirai-jp.gguf
LOCAL_LLM_URL=http://localhost:8080
LOCAL_LLM_MODEL=mirai-jp
# true = local chỉ làm CHỐT CUỐI sau Gemini/OpenRouter; false = không dùng local
USE_LOCAL_LLM=false
# TTS cũ (MeloTTS) — đã thay bằng ElevenLabs bên dưới
MELO_TTS_URL=http://localhost:8001

# ElevenLabs TTS (JP + VI, dùng 1 voice đa ngôn ngữ)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# TTS tự chỉnh theo JLPT trong code (N5 ~speed 0.75 → N1 ~1.05).
# Không cần set thêm trừ khi đổi voice/model.
# 0 = CPU. Chỉ dùng giá trị lớn hơn khi tự build llama.cpp có backend GPU.
LLAMA_GPU_LAYERS=0
WHISPER_MODEL_SIZE=base
LLM_MAX_TOKENS=512
# Speaking LLM timeouts (seconds)
LLM_TIMEOUT_GEMINI=12
LLM_TIMEOUT_OPENROUTER=10
LLM_TIMEOUT_LOCAL=15
LLM_CHAIN_BUDGET=28

# Auth
SPEAKING_INTERNAL_KEY=mirai-speaking-dev-key
SKIP_SPEAKING_AUTH=false
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173
