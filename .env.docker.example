# Copy to project root: cp .env.docker.example .env
# Then: docker compose up -d --build
#
# LOCAL TEST: HTTP_PORT=8080, FRONTEND_URL/CORS/VITE_REDIRECT = http://localhost:8080
# VPS:       HTTP_PORT=80,   thay bằng IP hoặc domain thật

# ─── Public URL ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://YOUR_VPS_IP_OR_DOMAIN
CORS_ORIGINS=http://YOUR_VPS_IP_OR_DOMAIN
VITE_GOOGLE_REDIRECT_URI=http://YOUR_VPS_IP_OR_DOMAIN
HTTP_PORT=80

# ─── MongoDB (Atlas hoặc mongo container riêng) ─────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/mirai

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_long_random_string
REFRESH_SECRET=change_me_another_long_random_string

# ─── Gemini (bắt buộc cho grammar OCR pipeline + RAG) ───────────────────────
GEMINI_API_KEY=your_gemini_key
GEMINI_API_KEY_AUDIT=
GEMINI_API_KEY_CV=

# ─── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=

# ─── Grammar queue (đã set trong compose, không cần đổi) ───────────────────
REDIS_URL=redis://redis:6379
ENABLE_GRAMMAR_QUEUE=true
SPEAKING_SERVICE_URL=http://ocr:8000

# ─── Speaking / OCR (container ocr — local AI stack) ─────────────────────────
ENABLE_SPEAKING_PRACTICE=true
VITE_ENABLE_SPEAKING_PRACTICE=true
SPEAKING_INTERNAL_KEY=mirai-speaking-dev-key
SKIP_SPEAKING_AUTH=true
ALLOWED_ORIGINS=http://YOUR_VPS_IP_OR_DOMAIN
# Local AI stack (primary)
LOCAL_LLM_URL=http://local-llm:11434
LOCAL_LLM_MODEL=qwen3-1.7b
MELO_TTS_URL=http://melo-tts:8001
WHISPER_BIN=/usr/local/bin/whisper-cli
WHISPER_MODEL=/models/ggml-small.bin
LLM_MAX_TOKENS=256
# Fallback APIs (optional — used when local LLM fails)
# GEMINI_API_KEY ở trên — container ocr dùng chung
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_MODEL=gemini-2.5-flash

# ─── ElevenLabs (Node BE) ───────────────────────────────────────────────────
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVEN_MODEL=eleven_flash_v2_5

# ─── Cloudinary / Mail (nếu dùng) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAIL_USER=
MAIL_PASS=

# ─── Atlas vector (tùy chọn) ────────────────────────────────────────────────
USE_ATLAS_VECTOR_SEARCH=false
ATLAS_VECTOR_INDEX=grammar_chunk_vector
