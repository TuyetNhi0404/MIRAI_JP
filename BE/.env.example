# =========================================================================
# ProjectK9 Backend Configuration Template (.env.example)
# Rename this file to '.env' and fill in your actual credentials.
# =========================================================================

# Application environment and port
NODE_ENV=development
PORT=5000

# MongoDB database connection URI
# Example: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGO_URI=your_mongodb_connection_uri_here

# JWT Authentication secret keys (use long, secure random strings)
JWT_SECRET=your_jwt_access_token_secret_here
REFRESH_SECRET=your_jwt_refresh_token_secret_here

# Nodemailer / Email Service configurations (for sending notifications/emails)
# If using Gmail, generate an "App Password" rather than your main password.
MAIL_USER=your_email_address@gmail.com
MAIL_PASS=your_email_app_password_here

# Google OAuth 2.0 Credentials (for server-side Google Sign-In verification)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cloudinary Credentials (for media/image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Google Gemini AI API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_AUDIT=your_gemini_audit_api_key_here
GEMINI_API_KEY_CV=your_gemini_cv_api_key_here

# ElevenLabs Text-to-Speech Credentials
ELEVEN_API_KEY=your_elevenlabs_api_key_here
ELEVEN_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVEN_MODEL=eleven_flash_v2_5

# AI Speaking Practice (FastAPI microservice)
ENABLE_SPEAKING_PRACTICE=false
SPEAKING_SERVICE_URL=http://127.0.0.1:8000
SPEAKING_INTERNAL_KEY=mirai-speaking-dev-key
